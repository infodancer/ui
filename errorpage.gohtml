{{- /*
  errorpage.gohtml — the content/title blocks RenderError fills into ui/document
  for a standard error page. Parsed into RenderError's own private template set
  (never the partials FS a consumer parses), so these block definitions can't
  leak into a consumer's page templates. The body uses ui's own classes; the
  copy (Title, Message) and status are the caller's.
*/ -}}
{{ define "title" }}{{ .Title }}{{ with .Meta.SiteName }} · {{ . }}{{ end }}{{ end }}
{{ define "content" -}}
<header class="app-page-header"><h1>{{ .Title }}</h1></header>
<section class="app-section app-prose">
  <p>{{ .Message }}</p>
</section>
{{- end }}
